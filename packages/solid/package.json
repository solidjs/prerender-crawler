{
  "name": "@solidjs/prerender",
  "version": "0.0.0",
  "description": "Build-time prerendering for Solid + Vite: crawls the built app into static HTML, and staticFunction() turns server functions into build-time data captured as static artifacts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "default": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.6",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/web": "^2.0.0-rc.6",
    "@types/node": "^22.0.0",
    "prerender-core": "workspace:*",
    "solid-js": "^2.0.0-rc.6",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
