{
  "name": "@solidjs/prerender",
  "version": "0.0.0",
  "description": "Solid's integration for prerender-crawler: prerendered() turns server functions into build-time data captured as static artifacts, and the serverFunctions() integration captures them during the crawl and guards static builds against calls nothing prerendered.",
  "license": "MIT",
  "author": "Ryan Carniato",
  "repository": {
    "type": "git",
    "url": "https://github.com/solidjs/prerender",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/solidjs/prerender/tree/main/packages/solid#readme",
  "bugs": "https://github.com/solidjs/prerender/issues",
  "keywords": [
    "solid",
    "solidjs",
    "prerender",
    "static site generation",
    "ssg",
    "server functions"
  ],
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "default": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "default": "./dist/integration.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.6",
    "prerender-crawler": "workspace:^"
  },
  "devDependencies": {
    "@solidjs/web": "^2.0.0-rc.6",
    "@types/node": "^22.0.0",
    "prerender-crawler": "workspace:^",
    "solid-js": "^2.0.0-rc.6",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0"
  }
}
