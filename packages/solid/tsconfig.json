{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "newLine": "LF",
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@solidjs/prerender/env": ["./src/env.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["./src", "./test"],
  "exclude": ["node_modules"]
}
